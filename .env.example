# Supabase Public Environment Variables (Required for browser & Vercel builds)
# Retrieve these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# SECURITY NOTE:
# NEVER place your Supabase service_role or sb_secret_ key in NEXT_PUBLIC_* variables.
